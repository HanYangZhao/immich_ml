# Version MUST match the ASUSTOR NAS release tag exactly
IMMICH_VERSION=v3.3.3

# ASUSTOR IP address (use 192.168.50.2 if using direct 2.5 GbE, or local LAN IP)
DB_HOSTNAME=192.168.50.2
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

REDIS_HOSTNAME=192.168.50.2
REDIS_PORT=6379

# Paths where your NAS shares are mounted on the PC
# Linux example:   /mnt/asustor/immich_data
# Windows example: Z:/immich_data (or //192.168.50.2/share/immich_data)
REMOTE_UPLOAD_LOCATION=/mnt/asustor/immich_data
REMOTE_EXTERNAL_LIB=/mnt/asustor/Photos_HDD
